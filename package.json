{
  "name": "tp-objetos",
  "version": "1.1.0",
  "description": "TypeScript example of the Composite pattern applied to nested packages and products.",
  "private": true,
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "start": "npm run build && node dist/paqueteria.js",
    "test": "npm run build && node --test dist/paqueteria.test.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agustinpitaro/TP-Objetos.git"
  },
  "author": "Agustin Pitaro",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/agustinpitaro/TP-Objetos/issues"
  },
  "homepage": "https://github.com/agustinpitaro/TP-Objetos#readme",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "cli-diagram": "0.3.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.9.2"
  }
}
